.page { padding-bottom: 40rpx; }

.upload-card { text-align: center; }
.up-icon {
  width: 110rpx; height: 110rpx; border-radius: 30rpx; margin: 0 auto 16rpx;
  background: linear-gradient(135deg, #5b8def, #7c6bff);
  display: flex; align-items: center; justify-content: center; font-size: 56rpx;
  box-shadow: 0 10rpx 24rpx rgba(91, 141, 239, 0.35);
}
.up-btn { margin-top: 20rpx; }

/* 已选照片预览网格 */
.preview-grid {
  display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 24rpx;
  justify-content: flex-start;
}
.pv-item {
  position: relative; width: 150rpx; height: 150rpx; border-radius: 16rpx;
  overflow: hidden; background: #f1f2f5; border: 1rpx solid #e6e8ef;
}
.pv-img { width: 100%; height: 100%; display: block; }
.pv-del {
  position: absolute; top: 4rpx; right: 4rpx; width: 40rpx; height: 40rpx;
  border-radius: 50%; background: rgba(0,0,0,0.55); color: #fff;
  font-size: 30rpx; line-height: 40rpx; text-align: center; font-weight: 700;
}
.pv-size {
  position: absolute; left: 0; right: 0; bottom: 0; font-size: 20rpx;
  color: #fff; background: rgba(0,0,0,0.4); text-align: center; line-height: 30rpx;
}

/* 批量提交栏 */
.submit-bar {
  display: flex; align-items: center; justify-content: space-between;
  gap: 16rpx; margin-top: 26rpx; padding-top: 22rpx; border-top: 1rpx solid #f0f1f5;
}
.sel-count { flex: none; }
.sub-btn { flex: 1; margin: 0; }
.clear-link {
  flex: none; font-size: 26rpx; color: #9aa1ad; padding: 10rpx 6rpx;
}

.rec {
  display: flex; align-items: center; justify-content: space-between;
  padding: 20rpx 0; border-bottom: 1rpx solid #f0f1f5;
}
.rec:last-child { border-bottom: none; }
.rec-status {
  display: inline-block; font-size: 24rpx; padding: 6rpx 18rpx; border-radius: 20rpx; margin-bottom: 8rpx; font-weight: 600;
}
.status-pending { background: #eef2ff; color: #5b6ef0; }
.status-done { background: #e7f7ec; color: #22a44e; }
.status-rejected_irrelevant { background: #f1f2f5; color: #9aa1ad; }

.fix-btn {
  font-size: 24rpx; color: #5b6ef0; background: #eef2ff;
  padding: 10rpx 22rpx; border-radius: 24rpx; font-weight: 600;
}

.empty { display: flex; flex-direction: column; align-items: center; padding: 90rpx 0; }
.empty-emoji { font-size: 88rpx; margin-bottom: 20rpx; }
