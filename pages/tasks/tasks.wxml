<view class="page">

  <!-- 科目多选 -->
  <view class="subj-bar" wx:if="{{subjects.length}}">
    <view class="subj-chip {{selectedSubjects.indexOf(s.key) > -1 ? 'on' : ''}}" wx:for="{{subjects}}" wx:key="key" wx:for-item="s" bindtap="toggleSubject" data-key="{{s.key}}">{{s.name}}</view>
  </view>

  <!-- 模式切换 -->
  <view class="mode-bar">
    <view class="mode-chip {{mode==='practice' ? 'on' : ''}}" bindtap="switchMode" data-mode="practice">智能提分练习</view>
    <view class="mode-chip {{mode==='roi' ? 'on' : ''}}" bindtap="switchMode" data-mode="roi">高价值任务卡</view>
  </view>

  <!-- 设置区 -->
  <view class="card setup">
    <view class="intro-title">{{mode==='practice' ? '智能提分练习' : '高价值任务卡'}}</view>
    <view class="muted">已选 <text class="hl">{{selectedSubjects.length}}</text> 科：内容来自所选科目最该补的项，选完一键生成可打印 A4 图（不含答案，铁律 3.11）。</view>

    <view class="row qty-row" wx:if="{{mode==='practice'}}">
      <view class="row-label">每科题量</view>
      <view class="stepper">
        <view class="step-btn" bindtap="dec">-</view>
        <view class="step-num">{{quantity}}</view>
        <view class="step-btn" bindtap="inc">＋</view>
        <view class="step-unit">题（每科 2–10）</view>
      </view>
    </view>

    <button class="btn-primary gen-btn" wx:if="{{!saving}}" bindtap="generate">一键生成可打印图片（{{selectedSubjects.length}}科 · 一页A4）</button>
    <view wx:if="{{saving}}" class="muted center" style="margin:14rpx 0;">生成中…</view>
  </view>

  <!-- 预览（与打印内容一致，不含答案） -->
  <view wx:if="{{printSections.length}}">
    <view class="prev-title">预览（与打印内容一致 · 不含答案）</view>
    <view wx:for="{{printSections}}" wx:key="subjectKey" wx:for-item="sec">
      <view class="sec-head">【{{sec.subjectName}}】</view>

      <!-- 练习模式（屏幕内可答题：选择题点选、fill 输入判分；发布时无答案，作答后反馈，铁律 3.11） -->
      <block wx:if="{{sec.kind==='practice'}}">
        <view class="card qcard" wx:for="{{sec.items}}" wx:key="id" wx:for-item="item">
          <view class="q-top">
            <text class="q-num">第 {{index+1}} 题</text>
            <text class="q-tag">{{item.tag}}</text>
          </view>
          <view class="q-stem">{{item.q}}</view>
          <!-- 选择题：点选判分 -->
          <view class="q-opts" wx:if="{{!item.isFill}}">
            <view class="q-opt {{results[item.id] && results[item.id].show ? (opt.correct ? 'opt-right' : (opt.l === results[item.id].picked ? 'opt-wrong' : 'opt-dim')) : ''}}"
                  wx:for="{{item.choices}}" wx:for-item="opt" wx:key="l"
                  bindtap="onPickOption" data-id="{{item.id}}" data-val="{{opt.l}}">
              <text class="opt-l">{{opt.l}}</text>
              <text class="opt-t">{{opt.t}}</text>
            </view>
          </view>
          <!-- fill：输入 + 判分 -->
          <view class="q-fill" wx:else>
            <input class="fill-input" value="{{answers[item.id]}}" bindinput="onInputFill"
                   data-id="{{item.id}}" placeholder="输入答案" confirm-type="done" maxlength="50" />
            <button class="fill-btn" size="mini" bindtap="onSubmitFill" data-id="{{item.id}}">判分</button>
          </view>
          <!-- 判分结果（作答后反馈） -->
          <view wx:if="{{results[item.id] && results[item.id].show}}" class="q-result {{results[item.id].correct ? 'r-ok' : 'r-no'}}">
            <view class="r-line">
              <text class="r-tag">{{results[item.id].correct ? '答对' : '答错'}}</text>
              <text class="r-ans" wx:if="{{!results[item.id].correct}}">参考答案：{{item.answer}}</text>
            </view>
            <view class="r-exp" wx:if="{{item.explain}}">{{item.explain}}</view>
          </view>
        </view>
      </block>

      <!-- ROI 模式 -->
      <block wx:if="{{sec.kind==='roi'}}">
        <view class="card roi-card" wx:for="{{sec.items}}" wx:key="id" wx:for-item="t">
          <view class="roi-head">
            <text class="roi-title">{{t.title}}</text>
            <text class="roi-tag">{{t.typeLabel}}{{t.roi != null ? ' · ROI ' + t.roi : ''}}</text>
          </view>
          <view class="roi-line" wx:for="{{t.lines}}" wx:key="label" wx:for-item="l">
            <text class="roi-label">{{l.label}}：</text><text class="roi-text">{{l.text}}</text>
          </view>
        </view>
      </block>
    </view>
  </view>

  <view wx:if="{{!subjects.length}}" class="empty">
    <view class="muted">暂无科目，请先在「掌握情况」上传作业生成考点</view>
  </view>

  <canvas type="2d" id="printCanvas" class="print-canvas"></canvas>
</view>
