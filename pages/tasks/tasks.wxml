<view class="page">

  <!-- 设置区：选考点（下拉）+ 题量（右） -->
  <view class="card setup" wx:if="{{!showing}}">
    <view class="intro-title">🎯 今日练习</view>
    <view class="muted">选择考点与题量，从题库随机抽取练习</view>

    <view class="row">
      <view class="row-label">练习考点</view>
      <picker class="picker" mode="selector" range="{{items}}" range-key="label" value="{{pickerIndex}}" bindchange="onPick">
        <view class="picker-box">
          <text>{{items[pickerIndex].label}}</text>
          <text class="picker-arrow">▾</text>
        </view>
      </picker>
    </view>

    <view class="row qty-row">
      <view class="row-label">练习题量</view>
      <view class="stepper">
        <view class="step-btn" bindtap="dec">−</view>
        <view class="step-num">{{quantity}}</view>
        <view class="step-btn" bindtap="inc">＋</view>
        <view class="step-unit">题（每科 2–10）</view>
      </view>
    </view>

    <button class="btn-primary gen-btn" bindtap="start">开始练习</button>
  </view>

  <!-- 练习区 -->
  <block wx:if="{{showing}}">
    <view class="practice-head">
      <view class="ph-left">
        <view class="ph-title">{{items[pickerIndex].label}}</view>
        <view class="muted">共 {{questions.length}} 题 · 点击题目看答案</view>
      </view>
      <view class="ph-right">
        <view class="ph-reveal" bindtap="revealAll">显示答案</view>
        <view class="ph-back" bindtap="back">← 设置</view>
      </view>
    </view>

    <view class="card qcard" wx:for="{{questions}}" wx:key="index" bindtap="toggleReveal" data-idx="{{index}}">
      <view class="q-top">
        <text class="q-num">第 {{index+1}} 题</text>
        <text class="q-tip">{{reveal[index] ? '隐藏答案' : '看答案'}}</text>
      </view>
      <view class="q-stem">{{item.q}}</view>
      <view class="q-opts">
        <view class="q-opt {{reveal[index] && opt.correct ? 'opt-right' : ''}}"
              wx:for="{{item.choices}}" wx:for-item="opt" wx:key="l">
          <text class="opt-l">{{opt.l}}</text>
          <text class="opt-t">{{opt.t}}</text>
        </view>
      </view>
      <view class="q-answer" wx:if="{{reveal[index]}}">
        <view class="ans-line"><text class="ans-tag">答案</text> {{item.answer}}</view>
        <view class="ans-exp" wx:if="{{item.explain}}">{{item.explain}}</view>
      </view>
    </view>
  </block>

  <view wx:if="{{!items.length && !showing}}" class="empty">
    <view class="empty-emoji">📚</view>
    <view class="muted">暂无考点，请先在「掌握看板」上传作业生成考点</view>
  </view>

</view>
