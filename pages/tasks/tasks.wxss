.page { padding-bottom: 40rpx; }

.chips { display: flex; flex-wrap: wrap; margin: 16rpx 0; }
.chip {
  padding: 12rpx 26rpx; margin: 8rpx 12rpx 8rpx 0;
  background: #f0f1f3; color: #6b7180; border-radius: 30rpx; font-size: 26rpx;
}
.chip-on { background: #4a90d9; color: #fff; }

.gen-btn { margin-top: 10rpx; }

.task-card { border-left: 8rpx solid #4a90d9; }
.tc-subj { font-size: 24rpx; color: #9aa0a6; }
.tc-title { font-size: 32rpx; font-weight: 700; color: #4a90d9; margin: 6rpx 0 14rpx; }
.tc-line { font-size: 27rpx; margin: 10rpx 0; line-height: 1.5; }
.tc-label {
  display: inline-block; min-width: 84rpx; font-size: 22rpx; color: #fff;
  background: #9aa0a6; border-radius: 8rpx; text-align: center; margin-right: 10rpx; padding: 2rpx 0;
}
.tc-label.red { background: #e04646; }
.tc-label.blue { background: #4a90d9; }
.tc-ipa { color: #9aa0a6; }

.save-btn { margin-top: 16rpx; }

.hidden-canvas {
  position: fixed;
  top: -9999px;
  left: -9999px;
  width: 360px;
  height: 560px;
}
