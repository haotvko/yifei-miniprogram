.page { padding-bottom: 40rpx; }

/* 科目多选条 */
.subj-bar { display: flex; flex-wrap: wrap; gap: 16rpx; padding: 22rpx 24rpx 4rpx; }
.subj-chip {
  padding: 16rpx 30rpx; border-radius: 16rpx;
  background: #eef1f7; color: #6b7280; font-size: 27rpx; font-weight: 700;
  border: 2rpx solid transparent;
}
.subj-chip.on { background: #eaf1ff; border-color: #5b6ef0; color: #2b2f38; box-shadow: 0 6rpx 16rpx rgba(91,141,239,0.18); }

.intro-title { font-size: 32rpx; font-weight: 800; }
.hl { color: #e04646; font-weight: 700; }

/* 模式切换条 */
.mode-bar { display: flex; gap: 16rpx; padding: 8rpx 24rpx 12rpx; }
.mode-chip {
  flex: 1; text-align: center; padding: 18rpx 0; border-radius: 16rpx;
  background: #eef1f7; color: #6b7280; font-size: 27rpx; font-weight: 700;
}
.mode-chip.on { background: linear-gradient(135deg, #5b8def, #6f6ef0); color: #fff; box-shadow: 0 6rpx 16rpx rgba(91,141,239,0.3); }

/* ROI 高价值任务卡 */
.roi-card { padding: 22rpx 26rpx 24rpx; margin-bottom: 14rpx; }
.roi-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12rpx; }
.roi-title { font-size: 30rpx; font-weight: 800; color: #2b2f38; flex: 1; padding-right: 14rpx; }
.roi-tag {
  flex: none; font-size: 21rpx; font-weight: 700; color: #5b6ef0;
  background: #eaf1ff; border-radius: 999rpx; padding: 4rpx 16rpx;
}
.roi-line { font-size: 25rpx; line-height: 1.55; margin: 8rpx 0; color: #2b2f38; }
.roi-label { color: #5b6ef0; font-weight: 700; }
.roi-text { color: #4a4f5a; }

/* 离屏打印画布（A4，高度随内容自适应） */
.print-canvas { position: fixed; left: -3000rpx; top: 0; width: 595px; height: 842px; }

/* 设置区 */
.setup { padding: 26rpx 28rpx 30rpx; }
.row { display: flex; align-items: center; margin: 22rpx 0; }
.row-label { font-size: 28rpx; font-weight: 700; color: #2b2f38; width: 150rpx; flex: none; }
.qty-row { justify-content: space-between; }

/* 题量步进器 */
.stepper { display: flex; align-items: center; }
.step-btn {
  width: 64rpx; height: 64rpx; line-height: 60rpx; text-align: center;
  background: #eef2ff; color: #5b6ef0; border-radius: 50%;
  font-size: 40rpx; font-weight: 700; border: 2rpx solid #d9e0ff;
}
.step-num { min-width: 64rpx; text-align: center; font-size: 38rpx; font-weight: 800; color: #2b2f38; }
.step-unit { font-size: 24rpx; color: #9aa1ad; margin-left: 14rpx; }

.gen-btn { margin-top: 24rpx; }
.prev-title { font-size: 26rpx; font-weight: 800; color: #6b7280; padding: 26rpx 24rpx 6rpx; }
.sec-head {
  font-size: 30rpx; font-weight: 800; color: #5b6ef0;
  padding: 22rpx 24rpx 10rpx; border-left: 8rpx solid #5b6ef0; margin: 14rpx 0 4rpx;
  background: #f6f9ff;
}
.btn-primary {
  background: linear-gradient(135deg, #5b8def, #6f6ef0);
  color: #fff; border-radius: 16rpx; font-size: 30rpx; font-weight: 700; padding: 20rpx 0;
}

/* 题目卡 */
.qcard { border-left: 8rpx solid #5b6ef0; }
.q-top { display: flex; justify-content: space-between; align-items: center; gap: 12rpx; }
.q-num { font-size: 26rpx; font-weight: 800; color: #5b6ef0; flex: none; }
.q-tag { font-size: 21rpx; color: #9aa1ad; flex: 1; text-align: left; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.q-stem { font-size: 30rpx; color: #2b2f38; line-height: 1.5; margin: 14rpx 0 18rpx; white-space: pre-wrap; }

.q-opts { display: flex; flex-direction: column; }
.q-opt {
  display: flex; align-items: center; background: #f4f6fb; border-radius: 12rpx;
  padding: 16rpx 20rpx; margin: 10rpx 0; font-size: 28rpx; color: #2b2f38;
}
.q-opt .opt-l {
  display: inline-block; min-width: 40rpx; height: 40rpx; line-height: 40rpx; text-align: center;
  background: #e2e7f0; color: #5b6ef0; border-radius: 8rpx; font-weight: 700; margin-right: 18rpx;
}
/* 屏幕答题判分反馈（作答后显示，发布时无答案，铁律 3.11） */
.q-opt.opt-right { background: #e9f9ee; }
.q-opt.opt-right .opt-l { background: #34c759; color: #fff; }
.q-opt.opt-wrong { background: #fdecec; }
.q-opt.opt-wrong .opt-l { background: #e04646; color: #fff; }
.q-opt.opt-dim { opacity: 0.5; }
.opt-t { flex: 1; }

/* fill 输入 + 判分 */
.q-fill { display: flex; align-items: center; margin-top: 8rpx; }
.fill-input {
  flex: 1; height: 64rpx; line-height: 64rpx; border: 2rpx solid #d3dae6;
  border-radius: 10rpx; padding: 0 16rpx; font-size: 28rpx; background: #fafbfd;
}
.fill-btn { margin-left: 16rpx; background: #5b6ef0; color: #fff; font-size: 26rpx; }

/* 判分结果（作答后反馈） */
.q-result { margin-top: 12rpx; padding: 12rpx 16rpx; border-radius: 10rpx; }
.q-result.r-ok { background: #e9f9ee; }
.q-result.r-no { background: #fdecec; }
.r-line { display: flex; align-items: center; flex-wrap: wrap; }
.r-tag { font-weight: 700; font-size: 26rpx; margin-right: 12rpx; }
.r-ok .r-tag { color: #1a8f4c; }
.r-no .r-tag { color: #e04646; }
.r-ans { font-size: 26rpx; color: #e04646; font-weight: 600; }
.r-exp { margin-top: 6rpx; font-size: 24rpx; color: #6b7180; }

.q-answer { margin-top: 18rpx; padding-top: 16rpx; border-top: 2rpx dashed #e2e7f0; }
.ans-line { font-size: 28rpx; font-weight: 700; color: #34c759; }
.ans-tag {
  display: inline-block; font-size: 22rpx; color: #fff; background: #34c759;
  border-radius: 8rpx; padding: 4rpx 14rpx; margin-right: 12rpx; font-weight: 700;
}
.ans-exp { font-size: 25rpx; color: #6b7180; line-height: 1.5; margin-top: 10rpx; }

/* 空状态 */
.empty { display: flex; flex-direction: column; align-items: center; padding: 90rpx 0; }
.empty-emoji { font-size: 88rpx; margin-bottom: 20rpx; }
.muted { color: #9aa1ad; font-size: 25rpx; }
.center { text-align: center; }
