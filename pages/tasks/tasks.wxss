.page { padding-bottom: 40rpx; }

.intro { background: linear-gradient(180deg, #ffffff, #fbfcff); }
.intro-title { font-size: 32rpx; font-weight: 800; }

.chips { display: flex; flex-wrap: wrap; margin: 18rpx 0; }
.chip {
  padding: 14rpx 28rpx; margin: 8rpx 14rpx 8rpx 0;
  background: #f0f1f5; color: #6b7180; border-radius: 32rpx; font-size: 26rpx; font-weight: 600;
  border: 2rpx solid transparent;
}
.chip-on {
  background: #eef2ff; color: #5b6ef0; border-color: #5b6ef0;
}

.gen-btn { margin-top: 8rpx; }

/* 任务卡 */
.task-card { border-left: 8rpx solid #5b6ef0; }
.tc-badge {
  display: inline-block; font-size: 22rpx; font-weight: 700; color: #5b6ef0;
  background: #eef2ff; padding: 6rpx 18rpx; border-radius: 20rpx; margin-bottom: 12rpx;
}
.tc-title { font-size: 34rpx; font-weight: 800; color: #2b2f38; margin: 4rpx 0 18rpx; line-height: 1.4; }
.tc-line { font-size: 27rpx; margin: 12rpx 0; line-height: 1.55; color: #444b57; }
.tc-strong { font-weight: 700; color: #2b2f38; }
.tc-label {
  display: inline-block; min-width: 80rpx; font-size: 22rpx; font-weight: 700; color: #6b7180;
  background: #f0f1f5; border-radius: 8rpx; text-align: center; margin-right: 12rpx; padding: 4rpx 0;
}
.tc-label-red { background: #fdecec; color: #e04646; }
.tc-label-blue { background: #eaf0ff; color: #5b6ef0; }
.tc-ipa { color: #9aa1ad; }

.save-btn { margin-top: 18rpx; }

/* 空状态 */
.empty { display: flex; flex-direction: column; align-items: center; padding: 90rpx 0; }
.empty-emoji { font-size: 88rpx; margin-bottom: 20rpx; }

.hidden-canvas {
  position: fixed; top: -9999px; left: -9999px;
  width: 360px; height: 560px;
}
