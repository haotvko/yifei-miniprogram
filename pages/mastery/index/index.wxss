.page { padding-bottom: 40rpx; }

/* 渐变 hero（横向紧凑） */
.hero {
  display: flex; align-items: center; justify-content: space-between;
  margin: 0 0 8rpx; padding: 28rpx 32rpx 30rpx;
  border-radius: 0 0 28rpx 28rpx; color: #fff;
}
.hero-left { flex: 1; padding-right: 20rpx; }
.hero-hi { font-size: 34rpx; font-weight: 800; }
.hero-sub { font-size: 24rpx; opacity: 0.92; margin-top: 6rpx; }
.hero-stat {
  margin-top: 16rpx; background: rgba(255,255,255,0.18);
  border-radius: 16rpx; padding: 10rpx 20rpx; display: inline-block;
}
.hs-num { font-size: 34rpx; font-weight: 800; }
.hs-label { font-size: 20rpx; opacity: 0.9; margin-left: 10rpx; }

.upd { margin: 16rpx 24rpx 0; text-align: center; }

/* 科目卡片 */
.subj-card { display: flex; align-items: center; }
.card-hover { transform: scale(0.985); }
.subj-emoji {
  width: 84rpx; height: 84rpx; border-radius: 22rpx; margin-right: 22rpx;
  background: #eef2ff; display: flex; align-items: center; justify-content: center; font-size: 44rpx;
}
.subj-mid { flex: 1; }
.subj-name { font-size: 34rpx; font-weight: 700; }
.subj-sub { margin-top: 6rpx; }
.subj-arrow { color: #c7ccd4; font-size: 40rpx; margin-left: 8rpx; }
