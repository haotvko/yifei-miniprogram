.page { padding-bottom: 40rpx; }

/* 渐变 hero（横向紧凑） */
.hero {
  display: flex; align-items: center; justify-content: space-between;
  margin: 0 0 8rpx; padding: 28rpx 32rpx 30rpx;
  border-radius: 0 0 28rpx 28rpx; color: #fff;
}
.hero-left { flex: 1; padding-right: 20rpx; }
.hero-name { font-size: 36rpx; font-weight: 800; }
.hero-hint { font-size: 24rpx; opacity: 0.92; margin-top: 8rpx; }

/* 现阶段掌握内容：2 列评分卡 */
.score-grid { display: flex; flex-wrap: wrap; }
.score-item { width: 50%; box-sizing: border-box; padding: 10rpx; }
.si-inner { background: #f7f8fc; border-radius: 18rpx; padding: 18rpx 18rpx 16rpx; height: 100%; }
.si-name { font-size: 24rpx; color: #2b2f38; line-height: 1.4; min-height: 64rpx; }
.si-score { font-size: 44rpx; font-weight: 800; margin: 4rpx 0 10rpx; }
.si-bar { height: 10rpx; background: #e7e9f0; border-radius: 6rpx; overflow: hidden; }
.si-bar-fill { height: 100%; border-radius: 6rpx; }
.si-tag { font-size: 20rpx; margin-top: 10rpx; }

/* 状态 pill（全色系） */
.pill { font-size: 22rpx; font-weight: 600; padding: 4rpx 16rpx; border-radius: 999rpx; }
.pill-red { background: #fdecec; color: #e04646; }
.pill-yellow { background: #fff3e0; color: #e08a00; }
.pill-blue { background: #eaf1ff; color: #3f6fd1; }
.pill-green { background: #e7f7ec; color: #22a44e; }
.pill-gray { background: #f0f1f5; color: #8a90a0; }

/* 核心薄弱项 */
.core { padding: 18rpx 0; border-bottom: 1rpx solid #f0f1f5; display: flex; flex-direction: column; }
.core:last-child { border-bottom: none; }
.core-head { display: flex; align-items: center; margin-bottom: 8rpx; }
.core-name { flex: 1; font-size: 28rpx; font-weight: 600; }

/* 当前最该攻的一项 · 引导去今日任务 */
.core-why { font-size: 24rpx; line-height: 1.5; }
.core-hint {
  margin-top: 14rpx; font-size: 23rpx; color: #5b6ef0;
  background: #eef2ff; border-radius: 12rpx; padding: 12rpx 16rpx;
}

/* 空状态 */
.empty-emoji { font-size: 56rpx; text-align: center; margin-bottom: 10rpx; }
