<view class="page" wx:if="{{!loading && subject}}">
  <!-- 渐变 hero（横向紧凑）：科目名 + 综合掌握度环 -->
  <view class="hero grad-primary">
    <view class="hero-left">
      <view class="hero-name">{{subject.name}}</view>
      <view class="hero-hint">{{subject.key_hint}}</view>
    </view>
    <view class="ring ring-md" style="background: conic-gradient({{subject.ringColor}} {{subject.ringPct}}%, rgba(255,255,255,0.22) 0);">
      <view class="ring-mask ring-mask-md">
        <text class="ring-num-md">{{subject.mastery_text}}</text>
      </view>
    </view>
  </view>

  <!-- 核心问题（最该攻克的薄弱点，红/黄优先） -->
  <view class="card" wx:if="{{core.length}}">
    <view class="section-title">🚨 核心问题（优先攻克）</view>
    <view class="core" wx:for="{{core}}" wx:key="point">
      <view class="core-head">
        <text class="core-emoji">{{item.emoji}}</text>
        <text class="core-name">{{item.point}}</text>
        <text class="pill pill-{{item.status}}">{{item.pct_text}} · {{item.status_label}}</text>
      </view>
      <view class="muted core-why">{{item.why}}</view>
    </view>
  </view>

  <view class="card center" wx:elif="{{!mastered.length}}">
    <view class="empty-emoji">🎉</view>
    <view class="muted">暂无核心问题，继续保持！</view>
  </view>

  <!-- 已掌握（绿色点） -->
  <view class="card" wx:if="{{mastered.length}}">
    <view class="section-title">✅ 已掌握（{{mastered.length}}）</view>
    <view class="mastered">
      <text class="tag" wx:for="{{mastered}}" wx:key="point">{{item.point}}</text>
    </view>
  </view>

  <view class="muted center foot">数据截至快照生成日 · 仅展示派生看板</view>
</view>
<view wx:else class="loading">
  <view class="spinner"></view>
  <text class="muted">加载中…</text>
</view>
