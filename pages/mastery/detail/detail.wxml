<view class="page" wx:if="{{!loading && subject}}">
  <!-- 渐变 hero（横向紧凑）：科目名 + 综合掌握度环 -->
  <view class="hero grad-primary">
    <view class="hero-left">
      <view class="hero-name">{{subject.name}}</view>
      <view class="hero-hint">{{subject.key_hint}}</view>
    </view>
    <view class="ring ring-md" style="background: conic-gradient({{subject.ringColor}} {{subject.ringPct}}%, rgba(255,255,255,0.22) 0);">
      <view class="ring-mask ring-mask-md">
        <text class="ring-num-md">{{subject.mastery_text}}</text>
      </view>
    </view>
  </view>

  <!-- 现阶段掌握内容：每项一个掌握度评分 -->
  <view class="card">
    <view class="section-title">现阶段掌握内容</view>
    <view class="score-grid">
      <view class="score-item" wx:for="{{items}}" wx:key="point" bindtap="openReport" data-point="{{item.point}}">
        <view class="si-inner">
          <view class="si-name">{{item.point}}</view>
          <view class="si-score" style="color:{{item.color}}">{{item.pct_text}}</view>
          <view class="si-bar"><view class="si-bar-fill" style="width:{{item.barPct}};background:{{item.color}}"></view></view>
          <view class="si-tag" style="color:{{item.color}}">{{item.status_label}}</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 核心薄弱项（最后一栏）：只取最该先攻的一项 -->
  <view class="card" wx:if="{{core.length}}">
    <view class="section-title">当前最该攻的一项</view>
    <view class="core" wx:for="{{core}}" wx:key="point">
      <view class="core-head">
        <text class="core-name">{{item.point}}</text>
        <text class="pill {{item.pill_class}}">{{item.pct_text}} · {{item.status_label}}</text>
      </view>
      <view class="muted core-why">{{item.why}}</view>
      <view class="core-hint">→ 在「今日任务」下拉选择此考点即可针对性练习</view>
    </view>
  </view>

  <view class="muted center foot">评分来自真实作业落笔 · 数据截至快照生成日</view>
</view>
<view wx:else class="loading">
  <view class="spinner"></view>
  <text class="muted">加载中…</text>
</view>
