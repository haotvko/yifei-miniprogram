<view class="page" wx:if="{{!loading}}">

  <!-- 渐变 hero：考点名 + 掌握度环 + 状态 -->
  <view class="hero grad-primary">
    <view class="hero-left">
      <view class="hero-sub">{{subjectName}} · 掌握情况详细汇报</view>
      <view class="hero-name">{{point}}</view>
      <view class="hero-pill"><text class="pill {{pill_class}} hero-pill-in">{{pct_text}} · {{status_label}}</text></view>
    </view>
    <view class="ring ring-md" style="background: conic-gradient({{ringColor}} {{ringPct}}%, rgba(255,255,255,0.22) 0);">
      <view class="ring-mask ring-mask-md">
        <text class="ring-num-md">{{pct_text}}</text>
      </view>
    </view>
  </view>

  <!-- 暂无汇报（如语文暂无作业） -->
  <view class="card" wx:if="{{!hasReport}}">
    <view class="section-title">📝 详细汇报</view>
    <view class="muted">该考点暂无详细汇报。上传相关作业并分析后，系统会自动生成「评分由来 / 具体扣分项 / 提分建议」。</view>
  </view>

  <block wx:if="{{hasReport}}">
    <!-- 评分由来：统计 + 说明 -->
    <view class="card">
      <view class="section-title">📊 评分由来</view>
      <view class="stat-row">
        <view class="stat"><view class="stat-num">{{report.stats.total}}</view><view class="stat-label">统计题数</view></view>
        <view class="stat stat-ok"><view class="stat-num">{{report.stats.correct}}</view><view class="stat-label">做对</view></view>
        <view class="stat stat-bad"><view class="stat-num">{{report.stats.wrong}}</view><view class="stat-label">做错</view></view>
        <view class="stat stat-rate"><view class="stat-num">{{pct_text}}</view><view class="stat-label">正确率</view></view>
      </view>
      <view class="report-para">{{report.score_origin}}</view>
    </view>

    <!-- 具体扣分项 -->
    <view class="card" wx:if="{{report.breakdown.length}}">
      <view class="section-title">🔍 具体扣分项（核心失分模式）</view>
      <view class="bd" wx:for="{{report.breakdown}}" wx:key="title">
        <view class="bd-bar"></view>
        <view class="bd-body">
          <view class="bd-title">{{item.title}}</view>
          <view class="bd-desc">{{item.desc}}</view>
          <view class="bd-from">📌 {{item.from}}</view>
        </view>
      </view>
    </view>

    <!-- 已稳定掌握 -->
    <view class="card" wx:if="{{report.strengths.length}}">
      <view class="section-title">✅ 已稳定掌握</view>
      <view class="strength" wx:for="{{report.strengths}}" wx:key="*this">
        <text class="chk">✓</text><text class="st-text">{{item}}</text>
      </view>
    </view>

    <!-- 提分建议 -->
    <view class="card tip-card">
      <view class="section-title">🎯 提分建议</view>
      <view class="report-para">{{report.next_step}}</view>
    </view>

    <!-- 去练习（针对核心扣分项） -->
    <view class="practice-btn grad-primary" bindtap="goPractice">去练习核心扣分项 →</view>
    <view class="muted center foot">汇报由 AI 基于真实作业落笔持续维护 · 数据截至快照生成日</view>
  </block>

</view>

<view wx:else class="loading">
  <view class="spinner"></view>
  <text class="muted">加载中…</text>
</view>
